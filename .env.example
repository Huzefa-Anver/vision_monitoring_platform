# Copy to .env and adjust. run.sh loads it.
PORT=8120
# where the platform writes captures/, frames/, crops/, state/, scan_events/, out_labels/, recordings/
SACK_PLATFORM_DATA=./data
# training project folder containing models/, datasets/, runs/, eval/
SACK_PROJECT_ROOT=..
# python with ultralytics + torch
PYTHON=python3
# optional: ffmpeg used by the RTSP recorder (default: ffmpeg on PATH, else imageio-ffmpeg)
# FFMPEG_BIN=/usr/bin/ffmpeg
# Serve RTSP (tab 12, MediaMTX in Docker). Video folder (default <data>/incoming_videos) and the address the RTSP
# port is published on (default 127.0.0.1 = this machine only; set the LAN IP to reach it from other machines).
# RTSP_VIDEO_DIR=/path/to/videos
# RTSP_HOST=192.168.1.10
# RTSP_PORT=8554
# RTSP_API_PORT=9997
# RTSP_CONTAINER=sack-rtsp-test
# RTSP_MEM=4g   (RAM cap of the RTSP container; about 1 GB per 3200x1800 re-encoded stream)
# Data folders under SACK_PLATFORM_DATA (all git-ignored): raw_videos/ (uploads, videos made from frames),
# raw_frames/ (uploaded frame sets), rtsp_serve/ (server config, loop clips, history)
